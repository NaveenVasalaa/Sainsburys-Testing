<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <EnableDefaultItems>false</EnableDefaultItems>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageOutputPath>.</PackageOutputPath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="**\*" Exclude="**\bin\**\*;**\obj\**\*;**\Properties\launchSettings.json;README.md;*.csproj;*.config" />
        <Compile Remove="**\*" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <PropertyGroup>
        <PackageType>Template</PackageType>
        <Version>8.0.1</Version>
        <PackageId>LSP.E2E.TestSuite</PackageId>
        <Title>LSP E2E TestSuite Template</Title>
        <Company>Sainsbury's</Company>
        <Authors>Naveen</Authors>
        <Description>A ready-to-use E2E Test Suite template for .NET Core with Microservices Integration Platforms.</Description>
        <PackageTags>lsp</PackageTags>
        <PackageProjectUrl>https://github.com/sainsburys-tech/lsp-common-project-templates/tree/master/lsp-e2e-testsuite-template</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/sainsburys-tech/lsp-common-project-templates.git</RepositoryUrl>
    </PropertyGroup>
</Project>